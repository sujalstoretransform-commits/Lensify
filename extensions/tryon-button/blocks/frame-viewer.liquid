{% assign frame_model = product.media | where: 'media_type', 'model' | first %}

{% if frame_model %}
  {% assign viewer_id = 'lensify-frame-viewer-' | append: block.id %}
  {% assign model_alt = frame_model.alt | default: product.title %}
  <div data-lensify-frame-viewer {{ block.shopify_attributes }}>
    <button type="button" class="lensify-frame-launch" aria-haspopup="dialog" aria-controls="{{ viewer_id | escape }}">
      {{ 'frame_viewer.open' | t }}
    </button>
    <dialog id="{{ viewer_id | escape }}" class="lensify-frame-dialog" aria-label="{{ 'frame_viewer.open' | t | escape }}">
      <form method="dialog" class="lensify-frame-dismiss">
        <button type="submit" autofocus aria-label="{{ 'frame_viewer.close' | t | escape }}">×</button>
      </form>
      <div class="lensify-frame-stage" data-frame-stage></div>
      <p class="lensify-frame-caption" data-frame-hint hidden>{{ 'frame_viewer.hint' | t }}</p>
      <p class="lensify-frame-caption" data-frame-loading role="status" hidden>{{ 'frame_viewer.loading' | t }}</p>
      <p class="lensify-frame-caption" data-frame-error role="status" hidden>{{ 'frame_viewer.error' | t }}</p>
    </dialog>
    <template>
      {{ frame_model | model_viewer_tag: alt: model_alt, touch-action: 'none', shadow-intensity: '0.8', image_size: '800x' }}
    </template>
  </div>
{% elsif request.design_mode %}
  <div class="lensify-frame-setup" {{ block.shopify_attributes }}>
    <p class="lensify-frame-setup-title">{{ 'frame_viewer.setup_title' | t }}</p>
    <p>{{ 'frame_viewer.setup' | t }}</p>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:frame_viewer.name",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "stylesheet": "frame-viewer.css",
  "javascript": "frame-viewer.js"
}
{% endschema %}
