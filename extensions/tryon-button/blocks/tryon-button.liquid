{% liquid
  assign dialog_id = 'lensify-dialog-' | append: block.id
  assign try_on_collection = block.settings.collection | default: collections.all
%}

{% capture catalog %}
  [
    {% for frame in try_on_collection.products limit: 50 %}
      {
        "id": {{ frame.id | append: '' | json }},
        "imageUrl": {% if frame.images.first %}{{ frame.images.first | image_url: width: 1280 | json }}{% else %}null{% endif %},
        "variantImages": {
          {% for variant in frame.variants %}
            {{ variant.id | append: '' | json }}:
            {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1280 | json }}{% else %}null{% endif %}
            {% unless forloop.last %},{% endunless %}
          {% endfor %}
        }
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
{% endcapture %}

<div
  popover="manual"
  data-lensify-dialog="{{ dialog_id | escape }}"
  {% if block.settings.collection != blank and collection.handle != block.settings.collection.handle %}data-lensify-restrict-collection{% endif %}
  data-lensify-extraction-url="{{ 'glasses-extraction.js' | asset_url | escape }}"
  {{ block.shopify_attributes }}
>
  <input type="hidden" data-lensify-catalog value="{{ catalog | strip_newlines | escape }}">
  <button
    type="button"
    class="lensify-launch"
    data-lensify-launch
    data-lensify-toggle
    aria-haspopup="dialog"
    aria-controls="{{ dialog_id | escape }}"
  >
    Try On Glasses
  </button>
  <button type="button" class="lensify-retake" data-lensify-launch data-lensify-retake hidden>
    Re-Upload
  </button>
  <p class="lensify-status" data-lensify-status role="status" hidden></p>
</div>

<dialog id="{{ dialog_id | escape }}" class="lensify-dialog" aria-label="Lensify try-on">
  <iframe title="Lensify camera and try-on"></iframe>
</dialog>

{% schema %}
{
  "name": "Try On Glasses",
  "target": "section",
  "stylesheet": "tryon-dialog.css",
  "javascript": "tryon-dialog.js",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Try-on collection" }
  ]
}
{% endschema %}
